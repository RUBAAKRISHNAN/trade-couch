// Prisma is used for simple CRUD only. The schema itself is owned by raw SQL migrations in
// db/migrations (partitions, triggers, CHECKs, BRIN and materialized views are beyond Prisma's DSL),
// so this file only maps the tables Prisma needs. Never run `prisma migrate` against this database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  USER
  ADMIN
  BOT
}

enum instrument_kind {
  LIVE_CRYPTO
  SIMULATED
}

enum instrument_status {
  ACTIVE
  HALTED
  DISABLED
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @unique @db.Citext
  passwordHash String        @map("password_hash")
  displayName  String        @map("display_name")
  role         user_role     @default(USER)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tokens       RefreshToken[]
  badges       UserBadge[]
  competitions Competition[]

  @@map("users")
}

model RefreshToken {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  familyId   String         @map("family_id") @db.Uuid
  tokenHash  String         @unique @map("token_hash")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?        @map("replaced_by") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement RefreshToken? @relation("Rotation", fields: [replacedBy], references: [id])
  replaces   RefreshToken[] @relation("Rotation")

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Instrument {
  symbol        String            @id
  name          String
  kind          instrument_kind
  tickSizePaise BigInt            @map("tick_size_paise")
  lotSizeUnits  BigInt            @map("lot_size_units")
  qtyScale      BigInt            @map("qty_scale")
  priceBandBps  Int               @map("price_band_bps")
  status        instrument_status @default(ACTIVE)
  feed          Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("instruments")
}

model Competition {
  id                BigInt   @id @default(autoincrement())
  name              String
  slug              String   @unique
  description       String   @default("")
  startsAt          DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime @map("ends_at") @db.Timestamptz(6)
  startingCashPaise BigInt   @map("starting_cash_paise")
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  creator           User?    @relation(fields: [createdBy], references: [id])

  @@map("competitions")
}

model Bot {
  id                BigInt   @id @default(autoincrement())
  accountId         BigInt   @map("account_id")
  symbol            String
  spreadBps         Int      @map("spread_bps")
  levels            Int      @default(5)
  levelStepBps      Int      @default(5) @map("level_step_bps")
  sizeUnits         BigInt   @map("size_units")
  maxInventoryUnits BigInt   @map("max_inventory_units")
  kind              String   @default("MAKER")
  enabled           Boolean  @default(true)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([accountId, symbol])
  @@map("bots")
}

model Badge {
  code        String      @id
  name        String
  description String
  icon        String      @default("award")
  awarded     UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    String   @map("user_id") @db.Uuid
  badgeCode String   @map("badge_code")
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeCode], references: [code])

  @@id([userId, badgeCode])
  @@map("user_badges")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
