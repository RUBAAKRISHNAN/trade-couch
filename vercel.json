{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @tradecore/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://trade-couch-api.onrender.com/api/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
