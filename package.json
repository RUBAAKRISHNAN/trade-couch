{
  "name": "tradecore",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db:create": "tsx --env-file-if-exists=.env scripts/db-create.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:migrate:test": "cross-env DB_NAME=tradecore_test tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed/seed.ts",
    "demo:traders": "tsx --env-file-if-exists=.env scripts/demo-traders.ts",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:migrate:test && npm run prisma:generate",
    "prisma:generate": "prisma generate --schema db/prisma/schema.prisma",
    "dev": "concurrently -k -n engine,api,worker,web -c magenta,cyan,yellow,green \"npm:dev -w @tradecore/engine\" \"npm:dev -w @tradecore/api\" \"npm:dev -w @tradecore/worker\" \"npm:dev -w @tradecore/web\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:engine": "tsx apps/engine/bench/bench.ts",
    "load:test": "tsx --env-file-if-exists=.env scripts/load-test.ts",
    "check:invariants": "tsx --env-file-if-exists=.env scripts/check-invariants.ts",
    "e2e": "playwright test",
    "clean": "rimraf \"**/dist\" \"**/.vite\"",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
