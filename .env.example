# Copy to .env and fill in. Never commit .env.
PG_USER=postgres
PG_PASSWORD=change-me
PG_HOST=localhost
PG_PORT=5432
REDIS_URL=redis://127.0.0.1:6379

# Optional overrides (defaults shown)
# DB_NAME=tradecore
# API_PORT=4300
# WEB_PORT=5200
# WEB_ORIGIN=http://localhost:5200
# JWT_SECRET=dev-only-change-me-to-a-long-random-string
# USD_INR=88.0                 # USD->INR rate used to convert live crypto prices (config value, not live)
# MARKET_FEEDS=coinbase,binance,kraken,simulated   # order = failover priority; "simulated" only = fully offline
# AI coach chat (optional — the app works fine without it). Create a free key at https://aistudio.google.com
# ("Get API key"). It stays on the server; only trading statistics are sent to Google, never names or emails.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash          # tried first; then GEMINI_FALLBACK_MODELS (default gemini-3.5-flash,gemini-2.5-flash)

# Seeded demo accounts (all use the same demo password): Demo@1234
