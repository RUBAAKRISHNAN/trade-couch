# Copy to .env and fill in. Never commit .env.
PG_USER=postgres
PG_PASSWORD=change-me
PG_HOST=localhost
PG_PORT=5432
REDIS_URL=redis://127.0.0.1:6379

# Optional overrides (defaults shown)
# DB_NAME=tradecore
# API_PORT=4300
# WEB_PORT=5200
# WEB_ORIGIN=http://localhost:5200
# JWT_SECRET=dev-only-change-me-to-a-long-random-string
# USD_INR=88.0                 # USD->INR rate used to convert live crypto prices (config value, not live)
# MARKET_FEEDS=coinbase,kraken,simulated   # order = failover priority; "simulated" only = fully offline
# AI_PROVIDER=                 # empty = AI coach summary disabled (works fine without it)

